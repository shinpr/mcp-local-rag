# Dependencies (installed inside the image)
node_modules
frontend/node_modules

.pnpm-store

# Build output
dist
frontend/dist

# Data directories (mounted as volumes at runtime)
lancedb
models
uploads

# Environment and secrets
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# IDE and editor
.vscode
.idea
.cursor
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation
*.md
LICENSE

# Test files and coverage
**/__tests__
**/*.test.ts
**/*.spec.ts
coverage

# Docker (not needed in build context)
docker-compose*.yml
Dockerfile*
.dockerignore

# CI / git hooks (not needed for image build)
