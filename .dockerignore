.husky

# Dev tooling configs (not used in Docker build)
biome.json
vitest.config.mjs
tsconfig.test.json
knip.json
.lintstagedrc
lint-staged.config.*

# Local dev scripts (entrypoint is copied by the API Dockerfile)
scripts/*
!scripts/docker-api-entrypoint.sh

# MCP registry metadata
server.json
