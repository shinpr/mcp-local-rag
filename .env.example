# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
NODE_ENV=production

# ──────────────────────────────────────────
# PostgreSQL (required for API server)
# ──────────────────────────────────────────
# Local dev / host Postgres: localhost
# Docker + bundled Postgres (--profile local-db): postgres
# Docker + external Postgres (mini-pc, no profile): LAN IP, e.g. 192.168.50.105
DB_HOST=localhost
DB_PORT=5432
DB_USER=mcp_local_rag_user
DB_PASSWORD=your_secure_password_here
DB_NAME=mcp_local_rag_db
# Optional: override all DB_* vars at once
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ──────────────────────────────────────────
# API Server
# ──────────────────────────────────────────
API_PORT=3939
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Max upload size for web UI file uploads (MB). Applied to API body/multipart limits
# and nginx proxy in Docker. Default: 50. Range: 1–500.
MAX_UPLOAD_SIZE_MB=50

# Default admin user (auto-created on first startup if all three are set)
# In development, these also pre-fill the login form via GET /auth/defaults.
# Remove these after first login if you don't want a seeded admin.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# ──────────────────────────────────────────
# RAG / Vector Storage
# ──────────────────────────────────────────
# LanceDB is file-based (not a network DB like Postgres). DB_PATH is always a
# directory on the machine running the API/CLI/MCP process.
DB_PATH=./lancedb/
MODEL_NAME=Xenova/all-MiniLM-L6-v2
CACHE_DIR=./models/
UPLOAD_DIR=./lancedb/uploads/
# Web uploads are stored under UPLOAD_DIR/<projectId>/<uuid>.<ext>.
# Keep UPLOAD_DIR inside DB_PATH (or the same bind mount) so LanceDB vectors
# and upload files live on one filesystem. docker-compose.yml sets
# UPLOAD_DIR=/app/lancedb/uploads inside the API container automatically.
RAG_DEVICE=cpu
DEFAULT_PROJECT=default

# ──────────────────────────────────────────
# Remote Postgres + local/remote LanceDB (split deployment)
# ──────────────────────────────────────────
# Postgres can run on another host (set DB_HOST to its LAN IP).
# LanceDB and UPLOAD_DIR must still be on the machine running the API process
# (or SSHFS-mounted — see "Remote LanceDB" below). Metadata in Postgres does
# not include file bytes; if DB_PATH/UPLOAD_DIR point at an empty local folder
# while another server holds the data, search/download/reindex will fail until
# you mount that directory or re-upload files.
#
# Mac dev example (Postgres on mini-pc, LanceDB over SSHFS):
#   DB_HOST=192.168.50.105
#   DB_PATH=./lancedb-remote/
#   UPLOAD_DIR=./lancedb-remote/uploads/
#
# Ubuntu Docker example (Postgres external, LanceDB on host disk):
#   DB_HOST=192.168.50.105
#   LANCEDB_HOST_PATH=/var/lib/mcp-local-rag/lancedb
#   (docker-compose bind-mounts that path to /app/lancedb in the API container)

# Ubuntu server: absolute host path bind-mounted into the API container
# LANCEDB_HOST_PATH=/var/lib/mcp-local-rag/lancedb
#
# Local dev over SSHFS (mount first: ./scripts/lancedb-mount.sh)
# LANCEDB_REMOTE_HOST=192.168.50.105
# LANCEDB_REMOTE_USER=your_ssh_user
# LANCEDB_REMOTE_PATH=/var/lib/mcp-local-rag/lancedb
# LANCEDB_LOCAL_MOUNT=./lancedb-remote
# DB_PATH=./lancedb-remote/
# UPLOAD_DIR=./lancedb-remote/uploads/

# ──────────────────────────────────────────
# Docker Compose
# ──────────────────────────────────────────
WEB_PORT=80

# Postgres container vars (only with --profile local-db)
# ──────────────────────────────────────────
POSTGRES_USER=mcp_local_rag_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mcp_local_rag_db
