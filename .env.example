# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
NODE_ENV=production

# ──────────────────────────────────────────
# PostgreSQL (required for API server)
# ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=mcp_local_rag_user
DB_PASSWORD=your_secure_password_here
DB_NAME=mcp_local_rag_db
# Optional: override all DB_* vars at once
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ──────────────────────────────────────────
# API Server
# ──────────────────────────────────────────
API_PORT=3939
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Default admin user (auto-created on first startup if all three are set)
# In development, these also pre-fill the login form via GET /auth/defaults.
# Remove these after first login if you don't want a seeded admin.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# ──────────────────────────────────────────
# RAG / Vector Storage
# ──────────────────────────────────────────
DB_PATH=./lancedb/
MODEL_NAME=Xenova/all-MiniLM-L6-v2
CACHE_DIR=./models/
UPLOAD_DIR=./uploads/
# Relative paths are resolved to absolute at startup. In Docker, use /app/uploads.
RAG_DEVICE=cpu
DEFAULT_PROJECT=default

# ──────────────────────────────────────────
# Docker Compose — Postgres container vars
# (only needed when running with --profile local-db)
# ──────────────────────────────────────────
POSTGRES_USER=mcp_local_rag_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mcp_local_rag_db
